NODE_ENV=development
PORT=4000

# Compose maps Mongo to host port 27018 (see docker-compose.yml). No auth unless you configure it.
MONGODB_URI=mongodb://localhost:27018/wtsp
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long-please
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long-please
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# 64 hex chars (32 bytes) for AES-256-GCM
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

FRONTEND_URL=http://localhost:5173

# --- Twilio / WhatsApp webhooks ---
# Credentials are stored per company in the app (Settings → Twilio account + WhatsApp number).
# These server vars are only for validating incoming POSTs from Twilio.
#
# 1) PUBLIC_API_BASE_URL — HTTPS URL where THIS API is reachable (no trailing slash).
#    Local dev: use ngrok / Cloudflare Tunnel, e.g. https://abc123.ngrok-free.app
#    Outbound messages will POST delivery status to: {PUBLIC_API_BASE_URL}/webhooks/twilio/status
#
# 2) In Twilio Console (Messaging → Try WhatsApp → Sandbox, or your WhatsApp sender config):
#    "When a message comes in" → POST → {PUBLIC_API_BASE_URL}/webhooks/twilio/incoming
#    (Status callback URL is optional if PUBLIC_API_BASE_URL is set — the app attaches it per send.)
#
# 3) TWILIO_WEBHOOK_AUTH_TOKEN — Auth Token of the SAME Twilio account that sends the webhooks
#    (usually the subaccount Auth Token you saved in Settings). If unset, signature check is skipped (dev only).
PUBLIC_API_BASE_URL=
TWILIO_WEBHOOK_AUTH_TOKEN=

# --- Meta WhatsApp Cloud API (multi-tenant) ---
# Per company in Settings: access token, App Secret, verify token, Phone Number ID.
# Each tenant gets a unique webhook URL after saving Meta credentials:
#   {PUBLIC_API_BASE_URL}/webhooks/meta/whatsapp/{webhookSlug}
# Optional legacy fallbacks (single shared Meta app in local dev only):
# META_APP_SECRET=
# META_VERIFY_TOKEN=

# --- Object storage (optional in development) ---
# Leave all empty to run API without uploads. For local MinIO (Docker): use block below.
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=

# MinIO (S3-compatible, no AWS account) — uncomment if docker-compose `minio` service is running:
# AWS_REGION=us-east-1
# S3_BUCKET=wtsp-media
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true

# Email (password reset uses console log in development when unset)
SMTP_URL=

LOG_LEVEL=info

# Optional: `npm run seed` demo user (defaults: demo@demo.local / DemoPass123!)
# SEED_DEMO_EMAIL=
# SEED_DEMO_PASSWORD=
# SEED_COMPANY_NAME=